{
  "name": "taskmanager-monorepo",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @taskmanager/web dev",
    "dev:api": "pnpm --filter @taskmanager/api dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "pnpm --filter @taskmanager/db db:generate",
    "db:migrate": "pnpm --filter @taskmanager/db db:migrate",
    "db:push": "pnpm --filter @taskmanager/db db:push",
    "db:studio": "pnpm --filter @taskmanager/db db:studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
