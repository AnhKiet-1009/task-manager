# ==============================================
# Database (Local Docker Postgres or Neon Free)
# ==============================================
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/taskmanager"

# ==============================================
# API Server (apps/api)
# ==============================================
PORT=8787
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ==============================================
# Better Auth (Email + GitHub OAuth)
# ==============================================
BETTER_AUTH_SECRET="replace-with-32-char-random-secret-in-prod"
BETTER_AUTH_URL="http://localhost:8787"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ==============================================
# GitHub App / Webhooks
# ==============================================
GITHUB_WEBHOOK_SECRET=""

# ==============================================
# AI Copilot (Free Tier Server Key + BYOK Vault)
# ==============================================
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GROQ_API_KEY=""
# 32-byte hex key used for AES-256-GCM encryption of Workspace BYOK keys
BYOK_ENCRYPTION_KEY=""

# ==============================================
# Rate Limit / Cache (Upstash Redis Free or Local)
# ==============================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==============================================
# Frontend (apps/web)
# ==============================================
VITE_API_URL="http://localhost:8787"
